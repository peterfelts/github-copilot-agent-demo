    "$fxv#0": "#cloud-config\npackage_update: true\npackage_upgrade: true\n\npackages:\n  - git\n  - wget\n\nruncmd:\n  # Install Go (version from environment variable, defaults to 1.21.5)\n  - GO_VERSION=${GO_VERSION:-1.21.5}\n  - wget -q https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz -O /tmp/go.tar.gz\n  - tar -C /usr/local -xzf /tmp/go.tar.gz\n  - rm /tmp/go.tar.gz\n  - echo 'export PATH=$PATH:/usr/local/go/bin' >> /etc/profile.d/go.sh\n  - echo 'export GOPATH=/opt/go' >> /etc/profile.d/go.sh\n  \n  # Clone the repository (repository URL from environment variable)\n  - REPO_URL=${REPOSITORY_URL:-https://github.com/peterfelts/github-copilot-agent-demo.git}\n  - git clone $REPO_URL /opt/copilot-demo\n  \n  # Build the application\n  - export PATH=$PATH:/usr/local/go/bin\n  - export GOPATH=/opt/go\n  - cd /opt/copilot-demo\n  - /usr/local/go/bin/go build -o github-copilot-agent-demo\n  \n  # Create systemd service\n  - |\n    cat > /etc/systemd/system/copilot-demo.service <<EOF\n    [Unit]\n    Description=GitHub Copilot Agent Demo Application\n    After=network.target\n\n    [Service]\n    Type=simple\n    User=root\n    WorkingDirectory=/opt/copilot-demo\n    EnvironmentFile=/etc/environment\n    ExecStart=/opt/copilot-demo/github-copilot-agent-demo\n    Restart=always\n    RestartSec=10\n\n    [Install]\n    WantedBy=multi-user.target\n    EOF\n  \n  # Enable and start the service (will start after environment is configured)\n  - systemctl daemon-reload\n  - systemctl enable copilot-demo.service\n  \n  # Wait for environment configuration from VM extension\n  - sleep 30\n  \n  # Start the service\n  - systemctl start copilot-demo.service\n\nwrite_files:\n  - path: /opt/copilot-demo/deploy.log\n    content: |\n      Deployment started\n    permissions: '0644'\n"
  },
