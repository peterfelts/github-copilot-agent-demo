        "settings": {
          "commandToExecute": "[format('IDENTITY_CLIENT_IDS=$(curl -s -H Metadata:true \"http://169.254.169.254/metadata/identity/info?api-version=2018-02-01\" | python3 -c ''import json,sys; data=json.load(sys.stdin); identities=data.get(\"userAssignedIdentities\", []); identities=identities.values() if isinstance(identities, dict) else identities; print(\",\".join(identity.get(\"clientId\", \"\") for identity in identities if identity.get(\"clientId\")))'' ) && echo \"MANAGED_IDENTITY_CLIENT_IDS=$IDENTITY_CLIENT_IDS\" >> /etc/environment && echo \"COSMOS_ACCOUNT_NAME={0}\" >> /etc/environment && echo \"TABLE_NAME={1}\" >> /etc/environment && echo \"METRICS_PORT=8080\" >> /etc/environment && echo \"REPOSITORY_URL={2}\" >> /etc/environment && echo \"GO_VERSION={3}\" >> /etc/environment', parameters('cosmosAccountName'), parameters('tableName'), parameters('repositoryUrl'), parameters('goVersion'))]"
        }
