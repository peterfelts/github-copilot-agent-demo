    },
    "metricsEndpoint": {
      "type": "string",
      "value": "[format('http://{0}:8080/metrics', reference(resourceId('Microsoft.Network/publicIPAddresses', format('{0}-pip', parameters('prefix'))), '2023-05-01').ipAddress)]"
    }
